(require 'ert)
(require 'cl-lib)
(require 'lemmaduck)
(ert-deftest lemmaduck-keeps-path-as-single-argument ()
  (should (equal (lemmaduck--command 'research "/tmp/a b;$(x)/")
                 '("lemmaduck" "agent" "/tmp/a b;$(x)/" "--pi")))
  (should (equal (lemmaduck--command 'code "/tmp/p/") '("lemmaduck" "code" "/tmp/p/"))))
(ert-deftest lemmaduck-dashboard-buttons-work ()
  (lemmaduck-dashboard)
  (with-current-buffer "*LemmaDuck*"
    (goto-char (point-min))
    (search-forward "Research / writing / assistant")
    (let ((button (button-at (1- (point)))) (called nil))
      (cl-letf (((symbol-function 'lemmaduck-research) (lambda () (interactive) (setq called t))))
        (button-activate button)
        (should called)))))
(ert-deftest lemmaduck-context-keeps-source-and-text ()
  (with-temp-buffer
    (setq buffer-file-name "/tmp/manuscript.md")
    (insert "Original claim.\nSecond sentence.")
    (lemmaduck-copy-context (point-min) (point-max))
    (should (string-match-p "manuscript.md:1-2" (current-kill 0)))
    (should (string-match-p "Original claim" (current-kill 0)))))
(ert-deftest lemmaduck-reuses-running-terminal ()
  (let* ((lemmaduck-project-directory temporary-file-directory)
         (lemmaduck--terminals (make-hash-table :test #'equal))
         (buffer (generate-new-buffer " *duck-live*"))
         (proc (start-process "duck-live" buffer "cat"))
         (shown nil))
    (unwind-protect
        (progn
          (puthash (cons (lemmaduck--project) 'research) buffer lemmaduck--terminals)
          (cl-letf (((symbol-function 'executable-find) (lambda (_) "/fake/lemmaduck"))
                    ((symbol-function 'pop-to-buffer) (lambda (b &rest _) (setq shown b))))
            (lemmaduck--start 'research)
            (should (eq shown buffer))))
      (delete-process proc) (kill-buffer buffer))))
